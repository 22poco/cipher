# Cipher frontend environment template.
# Copy this file to frontend/.env.local and replace placeholder values.
# Do not commit frontend/.env.local.

# Browser API base. Use the same-origin Next proxy for LAN/NetBird dev.
NEXT_PUBLIC_API_BASE_URL=/api/backend

# Server-side proxy target used by next.config.ts rewrites.
NEXT_BACKEND_PROXY_TARGET=http://127.0.0.1:8000

# Next.js dev-server host allowlist for LAN access.
# Use hostnames/IPs only; no protocol or port is required.
# Example LAN value: localhost,127.0.0.1,192.168.1.25
NEXT_ALLOWED_DEV_ORIGINS=localhost,127.0.0.1,100.125.24.70

# Public OAuth client IDs for browser-side provider buttons.
# Keep provider client secrets only in backend/.env.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=replace-with-google-web-client-id.apps.googleusercontent.com
NEXT_PUBLIC_GITHUB_CLIENT_ID=replace-with-github-oauth-client-id

# Backend routes expected to start provider OAuth flows.
NEXT_PUBLIC_GOOGLE_AUTH_URL=http://localhost:8000/auth/google/login
NEXT_PUBLIC_GITHUB_AUTH_URL=http://localhost:8000/auth/github/login
