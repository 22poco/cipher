# ---------------------------------------------------------------------------
# Cipher backend environment template.
# Copy this file to backend/.env and replace placeholder values.
# Do not commit backend/.env.
# ---------------------------------------------------------------------------

# Database engine.
# For the local-network classroom setup, this machine runs Postgres through
# docker-compose on host port 5433. If the FastAPI backend runs on this same
# machine, keep localhost here; browsers on the LAN should never connect to the
# database directly.
DATABASE_URL=postgresql://cipher_user:cipher_password@localhost:5433/cipher_db

# JWT/session settings.
SECRET_KEY=change-this-before-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Frontend origins allowed to call the API.
# These are full browser origins with scheme and port. For Next.js dev asset
# access from LAN devices, also set NEXT_ALLOWED_DEV_ORIGINS in frontend/.env.local.
# Add your LAN frontend origin when running from another device, for example:
# BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://192.168.1.25:3000
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Local app URLs used by OAuth redirect flows.
# The default local OAuth callback runs on the backend. These localhost values
# work when the browser is on this same machine.
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
OAUTH_REDIRECT_BASE_URL=http://localhost:8000
OAUTH_SUCCESS_REDIRECT_URL=http://localhost:3000/dashboard
OAUTH_FAILURE_REDIRECT_URL=http://localhost:3000/login?error=sso

# Google SSO.
# Create these in Google Cloud Console as a Web application OAuth client.
# Authorized JavaScript origins for local dev:
#   http://localhost
#   http://localhost:3000
#   http://127.0.0.1:3000
# Authorized redirect URI for local OAuth redirect flow:
#   http://localhost:8000/auth/google/callback
GOOGLE_SSO_ENABLED=true
GOOGLE_CLIENT_ID=replace-with-google-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_ALLOWED_DOMAIN=baisedu.org
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# GitHub SSO.
# Create these in GitHub Developer settings as an OAuth App.
# Homepage URL:
#   http://localhost:3000
# Authorization callback URL:
#   http://localhost:8000/auth/github/callback
GITHUB_SSO_ENABLED=true
GITHUB_CLIENT_ID=replace-with-github-oauth-client-id
GITHUB_CLIENT_SECRET=replace-with-github-oauth-client-secret
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback
GITHUB_OAUTH_SCOPE=read:user user:email
GITHUB_REQUIRE_VERIFIED_EMAIL=true
GITHUB_ALLOWED_EMAIL_DOMAIN=
