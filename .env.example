# copy to .env and edit before `docker compose -f docker-compose.prod.yml up`

# secret used to sign student/teacher login tokens.
# generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-before-sharing

# how STUDENT BROWSERS reach the backend.
# use the server's address, e.g. http://192.168.1.20:8000 or https://cipher.school.edu
# this is baked into the frontend build, so rebuild after changing it.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# frontend origins the backend accepts requests from (comma separated).
# must match how students open the app, e.g. http://192.168.1.20:3000
BACKEND_CORS_ORIGINS=http://localhost:3000

# postgres password (keep private; only used inside the compose network)
POSTGRES_PASSWORD=cipher_password
